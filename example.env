# Credenciais das tasks (Secret Provider local).
# Não coloque configuração do motor aqui (logs, URL da API, diretórios —
# isso vive em metro/settings.py).

METRO_PAGILA_POSTGRES_DATABASE=""
METRO_NORTHWIND_POSTGRES_DATABASE=""
METRO_STACKOVERFLOW_POSTGRES_DATABASE=""
# SQL Server connection string (formato: Server=...;Database=...;UID=...;PWD=...)
METRO_STACKOVERFLOW_SQL_SERVER_DATABASE=""

# Secret do runtime development_storage
METRO_DEVELOPMENT_STORAGE_BASE_PATH="./local"

# Credencial do serviço da Watermark API (não é secret de task)
METRO_WATERMARK_DATABASE=""